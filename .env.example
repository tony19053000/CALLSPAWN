# ---------------------------------------------------------------------------
# CallSwarm environment configuration. Copy to .env and fill in real values.
# Never commit .env. Never commit real phone numbers.
# ---------------------------------------------------------------------------

# --- Reasoning provider (Gemini) -------------------------------------------
# Either supply a Gemini API key, or set GOOGLE_GENAI_USE_VERTEXAI=true and use
# Application Default Credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- CALL-E ----------------------------------------------------------------
CALLE_API_KEY=
# The vendored OpenAPI snapshot labels this a placeholder base URL. Re-confirm it
# against live CALL-E documentation before enabling the real provider.
CALLE_API_BASE_URL=https://api.heycall-e.com

# Terminal webhook receiver. The CALL-E spec declares the webhook path
# unauthenticated, so our receiver is protected by this shared secret and by
# correlating every payload to a locally created call run.
CALLE_WEBHOOK_URL=
CALLE_WEBHOOK_SECRET=

# Master kill switch for real outbound calls. Keep false unless a live demo or
# an authorized test is actually being run. Credentials alone are NOT
# permission to dial: a real call also requires per-mission authorization.
CALLE_LIVE_CALLS_ENABLED=false

# Call provider selection: "fake" (default, no network) or "calle".
CALL_PROVIDER=fake

# Global safety ceilings, enforced in application code.
CALL_MAX_PER_MISSION=5
CALL_QUIET_HOURS_START=21:00
CALL_QUIET_HOURS_END=09:00
# Hard allow-list of E.164 numbers permitted for live calls, evaluated on top of
# the suppression deny-list. When CALLE_LIVE_CALLS_ENABLED=true an EMPTY list
# permits NO recipient at all. It exists so live testing cannot escape a known
# set of consenting numbers.
CALL_ALLOWED_RECIPIENTS=

# Minutes a PENDING approval stays decidable before it is marked EXPIRED.
APPROVAL_TTL_MINUTES=60

# --- Call value scoring (deterministic; calls/scoring.py) --------------------
# priority = clamp01(sum(weight * factor) - redundancy_penalty - cost_penalty).
# Positive weights sum to 1.0. Intents below CALL_MIN_PRIORITY are not selected.
CALL_MIN_PRIORITY=0.35
CALL_WEIGHT_MISSION_IMPACT=0.25
CALL_WEIGHT_UNCERTAINTY=0.15
CALL_WEIGHT_TIME_SENSITIVITY=0.10
CALL_WEIGHT_EXPECTED_VALUE=0.20
CALL_WEIGHT_STRATEGY_CHANGE_POTENTIAL=0.15
CALL_WEIGHT_EVIDENCE_IMPORTANCE=0.15
CALL_WEIGHT_REDUNDANCY=0.50
CALL_WEIGHT_CALL_COST=0.30

# --- Research provider -----------------------------------------------------
# "fixture" (default, labelled test data) or "gemini_grounded" (Gemini with the
# Google Search grounding tool; needs the Gemini credentials above). When live
# research is requested but no credentials exist the instance falls back to
# fixtures and records a blocker event on every mission that researches.
RESEARCH_PROVIDER=fixture
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=
# Directory scanned recursively for research.json fixtures (relative to backend/).
RESEARCH_FIXTURE_DIR=../scenarios
# Public-page fetch limits (robots.txt is always honored).
RESEARCH_FETCH_TIMEOUT_SECONDS=5
RESEARCH_FETCH_MAX_BYTES=512000

# --- Output sanitizer ------------------------------------------------------
# Comma-separated phrases treated as private-reasoning leaks. Any API response,
# activity event or persisted agent artifact containing one is rejected.
# Leave unset for the built-in defaults ("<thinking>", "chain of thought", ...).
REASONING_LEAK_MARKERS=

# --- Persistence -----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./callswarm.db

# --- Server ----------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Orchestration ---------------------------------------------------------
# Clarification questions with importance >= this are asked; the rest become
# recorded assumptions.
CLARIFICATION_IMPORTANCE_THRESHOLD=0.6
# How many generated agents may execute concurrently.
AGENT_CONCURRENCY=4
# Comma-separated purposes no generated agent may own. Leave unset for the
# built-in list (medical diagnosis, legal advice, financial trading, credential
# or OTP collection, impersonation, debt collection, political persuasion).
PROHIBITED_AGENT_PURPOSES=
